    <dashboard name='Story ' type='storyboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run>EV MARKET ANALYSIS- Sales &amp; Performance Insights</run>
          </formatted-text>
        </title>
      </layout-options>
      <style />
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98120' id='1' param='vert' removable='false' type-v2='layout-flow' w='99062' x='469' y='940'>
            <zone h='4935' id='3' type-v2='title' w='99062' x='469' y='940' />
            <zone h='11868' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='99062' x='469' y='5875' />
            <zone h='81317' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='99062' x='469' y='17743'>
              <flipboard active-id='3' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption=' Scene 1: EV Sales by Manufacturer&#10;&#10;This visualization presents the sales performance of different EV manufacturers and helps identify which manufacturers contribute most to the electric vehicle market.' captured-sheet='EV Sales by Manufacturer' id='1' />
                  <story-point caption=' Scene 2: EV Sales by Region&#10;&#10;This visualization shows the distribution of electric vehicle sales across different market regions. It helps identify the regions contributing significantly to the EV market.' captured-sheet='EV Sales by Region' id='2' />
                  <story-point caption=' Scene 3: EV Sales by Category&#10;&#10;This visualization compares electric vehicle sales across different categories. It helps identify which vehicle categories have higher sales and which have lower market demand.' captured-sheet='EV Sales by category' id='3' />
                  <story-point caption=' Scene 4: EV Sales Trend by Model Year&#10;&#10;This visualization illustrates the trend of electric vehicle sales across different model years. It helps us understand how EV sales change over time and identify years with higher or lower sales.' captured-sheet='EV Sales by Model Year' id='4' />
                  <story-point caption=' Scene 5: EV Sales by Battery Type&#10;&#10;This visualization presents the sales distribution of electric vehicles across different battery types. It helps compare battery types and understand their contribution to the EV market.' captured-sheet='EV sales by Battery Type' id='5' />
                  <story-point caption=' Scene 6: EV Performance Analysis&#10;&#10;This visualization provides an overview of electric vehicle performance across different categories. It helps compare performance indicators and understand differences among EV categories.' captured-sheet='EV Performance Analysis' id='6' />
                  <story-point caption=' Scene 7: EV Market Performance Dashboard&#10;&#10;This dashboard provides a comprehensive overview of the electric vehicle market. It combines key performance indicators, sales visualizations, and interactive filters to analyze EV sales across manufacturers, regions, categories, model years, and battery types.&#10;&#10;It helps users explore market trends, compare sales performance, and understand the overall EV market.' captured-sheet='EV Market Performance Dashboard' id='7' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#444444' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone flipboard-zone-id='5' h='23267' hidden='true' id='6' story-point-id='1' type-v2='text' w='30814' x='66960' y='68625'>
          <formatted-text>
            <run bold='true' fontalignment='0'> EV Sales by Manufacturer</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0'>This visualization presents the sales performance of different EV manufacturers and helps identify which manufacturers contribute most to the electric vehicle market.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='33020' hidden='true' id='7' story-point-id='2' type-v2='text' w='29643' x='68424' y='33255'>
          <formatted-text>
            <run fontalignment='0'>2: EV Sales by Region

This visualization shows the distribution of electric vehicle sales across different market regions. It helps identify the regions contributing significantly to the EV market.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='15511' id='8' story-point-id='3' type-v2='text' w='33333' x='32923' y='76263'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontsize='11'>3: EV Sales by Category</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontsize='11'>This visualization compares electric vehicle sales across different categories. It helps identify which vehicle categories have higher sales and which have lower market demand.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='22562' hidden='true' id='9' story-point-id='4' type-v2='text' w='33333' x='59930' y='56874'>
          <formatted-text>
            <run bold='true' fontalignment='0'>4: EV Sales Trend by Model Year</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0'>This visualization illustrates the trend of electric vehicle sales across different model years. It helps us understand how EV sales change over time and identify years with higher or lower sales.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='22562' hidden='true' id='10' story-point-id='5' type-v2='text' w='33333' x='47510' y='42068'>
          <formatted-text>
            <run bold='true' fontalignment='0'>5: EV Sales by Battery Type</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0'>This visualization presents the sales distribution of electric vehicles across different battery types. It helps compare battery types and understand their contribution to the EV market.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='22562' hidden='true' id='11' story-point-id='6' type-v2='text' w='33333' x='56473' y='34313'>
          <formatted-text>
